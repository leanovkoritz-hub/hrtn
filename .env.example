# Copy this file to .env.local and fill in your own values.

# Admin login credentials for the internal dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Random long string used to sign admin session cookies (any random 32+ char string)
SESSION_SECRET=replace-this-with-a-long-random-string

# Path to the local SQLite database file (created automatically)
DATABASE_PATH=./data/simtrack.db
